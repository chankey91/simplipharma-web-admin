# Copy to .env.simplipharma / .env.simplipharma-dev (gitignored) or use:
#   npx firebase functions:config:export
#
# Env vars are preferred; functions.config() remains as fallback until Runtime Config sunset.

SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_ADMIN_NOTIFY=

TYPESENSE_HOST=
TYPESENSE_API_KEY=
TYPESENSE_SEARCH_API_KEY=
TYPESENSE_PROTOCOL=http
TYPESENSE_PORT=8088

APP_PANEL_URL=
APP_RETAILER_LANDING_URL=
APP_RETAILER_PASSWORD_RESET_CONTINUE_URL=
APP_SO_PASSWORD_RESET_CONTINUE_URL=
APP_PO_PASSWORD_RESET_CONTINUE_URL=

SUPPORT_NOTIFY_EMAILS=

# Optional invoice OCR / Gemini
GOOGLE_GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_PROJECT=
GOOGLE_VERTEX_LOCATION=asia-south1
GOOGLE_VISION_API_KEY=
